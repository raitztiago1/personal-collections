# Copie para .env (`copy .env.example .env`). AUTH_SECRET é obrigatório.
# Gere um valor ANTES do primeiro `npm run dev` (não use o placeholder abaixo):
#   openssl rand -base64 32
#   ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://catalogo:catalogo@localhost:5432/catalogo
AUTH_SECRET=gere-um-valor-longo
AUTH_URL=http://localhost:3000
ALLOW_REGISTRATION=true
UPLOAD_DIR=data/uploads
